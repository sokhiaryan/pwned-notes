{"openapi":"3.1.0","info":{"title":"KumoSec ChainVault","description":"Blockchain-based bug bounty escrow platform.\n\nManages escrowed ETH for security audit bounty payouts.\n\n**Auditor Registration:**\nAuditor access is managed via KumoSec Enterprise Security.\n\n**RPC Endpoint:**\nConnect your web3 provider to `/chain/rpc` to interact with the private chain.","version":"2.1.0"},"paths":{"/api/v1/health":{"get":{"tags":["Status"],"summary":"Health","description":"Health check for Docker/load balancer.","operationId":"health_api_v1_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/v1/status":{"get":{"tags":["Status"],"summary":"Platform Status","description":"Public platform status page.","operationId":"platform_status_api_v1_status_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/v1/vault/info":{"get":{"tags":["Vault"],"summary":"Vault Info","description":"Get team's deployed contract addresses and vault status.\n\nRequires team authentication via X-CTF-Team-Token header.\nFirst access triggers automatic contract deployment.","operationId":"vault_info_api_v1_vault_info_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/v1/vault/wallet":{"get":{"tags":["Vault"],"summary":"Wallet Info","description":"Get team's pre-funded wallet credentials.\n\nReturns the private key for the team's funded wallet.\nUse this with web3.py, ethers.js, or Foundry cast to interact\nwith the contracts.","operationId":"wallet_info_api_v1_vault_wallet_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/v1/vault/reset":{"post":{"tags":["Vault"],"summary":"Reset Vault","description":"Reset team's blockchain state.\n\nDeletes existing contracts and redeploys fresh instances.\nUse this if you've broken your environment.","operati